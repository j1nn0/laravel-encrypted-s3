{
    "name": "j1nn0/laravel-encrypted-s3",
    "description": "Laravel filesystem adapter for AWS S3 Client-Side Encryption V3.",
    "keywords": [
        "laravel",
        "filesystem",
        "s3",
        "aws",
        "kms",
        "encryption",
        "client-side-encryption",
        "cse",
        "flysystem"
    ],
    "homepage": "https://github.com/j1nn0/laravel-encrypted-s3",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "j1nn0",
            "email": "j1nn0.github@gmail.com",
            "homepage": "https://github.com/j1nn0"
        }
    ],
    "support": {
        "issues": "https://github.com/j1nn0/laravel-encrypted-s3/issues",
        "source": "https://github.com/j1nn0/laravel-encrypted-s3"
    },
    "require": {
        "php": "^8.2",
        "ext-openssl": "*",
        "aws/aws-sdk-php": "^3.382.2",
        "illuminate/filesystem": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "league/flysystem": "^3.29",
        "league/flysystem-aws-s3-v3": "^3.29",
        "league/mime-type-detection": "^1.0",
        "psr/http-message": "^1.0 || ^2.0",
        "symfony/http-foundation": "^7.2 || ^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0",
        "laravel/pint": "^1.0",
        "larastan/larastan": "^3.10",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "J1nn0\\EncryptedS3\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "J1nn0\\EncryptedS3\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "J1nn0\\EncryptedS3\\EncryptedS3ServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:integration": "vendor/bin/phpunit --testsuite=Integration",
        "lint": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
